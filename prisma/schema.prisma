// [วางโค้ด Phase 1 ที่นี่]
// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Auth Enums ---

enum ProjectAccessType {
  PUBLIC
  PRIVATE
}

enum SystemRole {
  ADMIN
  USER
}

enum ProjectRole {
  VIEWER
  EDITOR
  ADMIN
}

// --- Feature Enums ---

enum Severity {
  NOT_SET
  BLOCKER
  CRITICAL
  MAJOR
  NORMAL
  MINOR
  TRIVIAL
}

enum Priority {
  NOT_SET
  HIGH
  MEDIUM
  LOW
}

enum AutomationStatus {
  MANUAL
  TO_BE_AUTOMATED
  AUTOMATED
}

enum TestRunStatus {
  ACTIVE
  COMPLETED
  ABORTED
}

enum TestResultStatus {
  PASSED
  FAILED
  BLOCKED
  SKIPPED
  IN_PROGRESS
  INVALID
}

enum FieldType {
  STRING
  TEXT
  SELECT
  MULTI_SELECT
  CHECKBOX
  NUMBER
  RADIO
  USER_PICKER
  URL
  DATE_PICKER
}

enum DeploymentStatus {
  PENDING
  BUILDING
  SUCCESS
  FAILED
}

enum NotificationType {
  ASSIGNMENT
  MENTION
  SYSTEM
  RUN_STARTED
  RUN_COMPLETED
}

// --- Auth & User Models ---

model User {
  id                     String               @id @default(uuid())
  email                  String               @unique
  passwordHash           String
  name                   String?
  role                   SystemRole           @default(USER)
  isActive               Boolean              @default(true)
  workspaceRoleId        String?
  workspaceRole          WorkspaceRole?       @relation(fields: [workspaceRoleId], references: [id], onDelete: SetNull)
  projects               ProjectMember[]
  testCases              TestCase[]
  assignedRunResults     TestRunResult[]
  executedRunResults     TestRunResult[]      @relation("ResultExecutor")
  authoredRuns           TestRun[]            @relation("RunAuthor")
  auditLogs              AuditLog[]
  groups                 Group[]              @relation("GroupMembers")
  passwordResetTokens    PasswordResetToken[]
  apiTokens              ApiToken[]
  receivedNotifications  Notification[]       @relation("NotificationRecipient")
  triggeredNotifications Notification[]       @relation("NotificationActor")
  comments               Comment[]
  lastSeenAt             DateTime?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@index([workspaceRoleId])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

/// Personal access token for the public REST API (/api/v1).
/// Only the SHA-256 hash is stored — the token itself is shown once, at
/// creation, and is unrecoverable afterwards. A request authenticated with a
/// token acts as `user`, so it inherits exactly that user's project roles.
model ApiToken {
  id         String    @id @default(uuid())
  name       String // human label, e.g. "GitHub Actions"
  tokenHash  String    @unique // sha256 of the plaintext token
  prefix     String // first chars, shown in the UI so a token is recognisable
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastUsedAt DateTime?
  expiresAt  DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model LinkedIssue {
  id       String  @id @default(uuid())
  provider String  @default("JIRA") // JIRA | GITHUB
  key      String // e.g. "PROJ-123" or issue number
  url      String  @db.Text
  summary  String  @db.Text
  status   String? // synced issue status, optional
  severity String? // severity captured at creation time

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  caseId   String?
  testCase TestCase? @relation(fields: [caseId], references: [id], onDelete: SetNull)

  resultId String?
  result   TestRunResult? @relation(fields: [resultId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([caseId])
  @@index([resultId])
}

model Group {
  id          String    @id @default(uuid())
  title       String
  description String?
  members     User[]    @relation("GroupMembers")
  projects    Project[] @relation("GroupProjects")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProjectMember {
  id        String      @id @default(uuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

// --- Core Models ---

model ProjectInvitation {
  id        String      @id @default(uuid())
  email     String
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  role      ProjectRole @default(VIEWER)
  token     String      @unique
  expiresAt DateTime
  createdAt DateTime    @default(now())

  @@unique([email, projectId])
  @@index([token])
}

model Project {
  id           String            @id @default(uuid())
  name         String
  code         String            @unique // e.g., "PROJ"
  description  String?
  isArchived   Boolean           @default(false)
  accessType   ProjectAccessType @default(PUBLIC)
  caseSequence Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Integrations
  githubOwner       String?
  githubRepo        String?
  githubToken       String?
  githubWorkflowId  String?
  msTeamsWebhookUrl String?

  /// Qase project code this project mirrors, e.g. "BO". Set it to opt the
  /// project into webhook sync; leaving it null means Qase events for that
  /// code are recorded and ignored. Unique so an incoming event maps to
  /// exactly one project.
  qaseProjectCode String? @unique

  suites             TestSuite[]
  testCases          TestCase[]
  testRuns           TestRun[]
  testPlans          TestPlan[]
  members            ProjectMember[]
  projectInvitations ProjectInvitation[]
  auditLogs          AuditLog[]
  tags               Tag[]
  attachments        Attachment[]
  customFields       CustomField[]       @relation("ProjectToCustomField")
  environments       Environment[]
  milestones         Milestone[]
  sharedSteps        SharedStep[]
  pipelines          PipelineSchedule[]
  groups             Group[]             @relation("GroupProjects")
  linkedIssues       LinkedIssue[]

  @@index([code])
}

model TestSuite {
  id          String  @id @default(uuid())
  title       String
  description String?
  position    Int     @default(0)

  // Project Relation
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Self-relation for nested tree structure
  parentId String?
  parent   TestSuite?  @relation("SuiteToSuite", fields: [parentId], references: [id], onDelete: Cascade)
  children TestSuite[] @relation("SuiteToSuite")

  testCases TestCase[]

  externalId String? // e.g. Qase suite id, for one-off migration idempotency

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, externalId])
}

model TestCase {
  id                  String           @id @default(uuid())
  title               String
  description         String?          @db.Text
  preconditions       String?          @db.Text
  postconditions      String?          @db.Text
  severity            Severity         @default(NORMAL)
  priority            Priority         @default(MEDIUM)
  automationStatus    AutomationStatus @default(MANUAL)
  automationScript    String?          @db.Text
  lastVerificationLog String?          @db.Text
  githubPrUrl         String?          @db.Text
  jiraId              String?
  requirementText     String?          @db.Text
  isOutdated          Boolean          @default(false)

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  suiteId String?
  suite   TestSuite? @relation(fields: [suiteId], references: [id], onDelete: SetNull)

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  /// Soft delete. Set instead of removing the row, so a case deleted by
  /// mistake can be restored — twelve were lost this way in one week, and the
  /// only reason they came back is that Qase still held them. Reads go through
  /// the extension in lib/prisma.ts, which hides these rows everywhere.
  deletedAt    DateTime?
  deletedById  String?
  linkedIssues LinkedIssue[]

  steps       TestStep[]
  runResults  TestRunResult[]
  tags        Tag[]
  attachments Attachment[]
  comments    Comment[]
  testPlans   TestPlan[]      @relation("TestPlanToTestCase")

  customFields   Json? // Stores custom field values
  sequenceNumber Int     @default(0)
  externalId     String? // e.g. Qase case id, for one-off migration idempotency

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, sequenceNumber])
  @@index([projectId])
  @@index([suiteId])
  // Every list query filters on this, so it belongs in the index.
  @@index([projectId, deletedAt])
}

model Tag {
  id   String @id @default(uuid())
  name String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCases TestCase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, projectId])
  @@index([projectId])
}

model TestStep {
  id             String  @id @default(uuid())
  action         String  @db.Text
  expectedResult String? @db.Text
  position       Int // To maintain order in UI

  caseId   String
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  sharedStepId String?
  sharedStep   SharedStep? @relation(fields: [sharedStepId], references: [id], onDelete: SetNull)

  @@index([caseId])
}

model TestRun {
  id          String        @id @default(uuid())
  title       String
  description String?
  status      TestRunStatus @default(ACTIVE)
  isPublic    Boolean       @default(false)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  authorId String?
  author   User?   @relation("RunAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  planId String?
  plan   TestPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)

  milestoneId String?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  reportUrl String? @db.Text

  externalId String? // e.g. Qase run id, for one-off migration idempotency

  results  TestRunResult[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model Comment {
  id       String  @id @default(uuid())
  body     String  @db.Text
  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  caseId String?
  case   TestCase? @relation(fields: [caseId], references: [id], onDelete: Cascade)

  runId String?
  run   TestRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([caseId, createdAt])
  @@index([runId, createdAt])
}

model TestRunResult {
  id               String           @id @default(uuid())
  status           TestResultStatus @default(IN_PROGRESS)
  timeSpent        Int? // Duration in milliseconds
  errorMessage     String?          @db.Text
  comment          String?          @db.Text
  stepResults      Json? // Array of step-level results
  executionHistory Json? // Array of past execution logs

  runId   String
  testRun TestRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  caseId   String
  testCase TestCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id], onDelete: SetNull)

  /// Who actually recorded the outcome, and when. Distinct from `assignee`,
  /// which is only who the case was handed to — the person who ran it may be
  /// someone else, and for CI it is the API token's owner.
  executedById String?
  executedBy   User?     @relation("ResultExecutor", fields: [executedById], references: [id], onDelete: SetNull)
  executedAt   DateTime?

  attachments  Attachment[]
  linkedIssues LinkedIssue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([runId, caseId])
  @@index([runId])
  @@index([caseId])
}

model Attachment {
  id           String @id @default(uuid())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCaseId String?
  testCase   TestCase? @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  resultId  String?
  runResult TestRunResult? @relation(fields: [resultId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

model TestPlan {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCases TestCase[]         @relation("TestPlanToTestCase")
  testRuns  TestRun[]
  pipelines PipelineSchedule[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model WorkspaceRole {
  id          String  @id @default(uuid())
  title       String
  description String? @db.Text
  isSystem    Boolean @default(false)
  isDefault   Boolean @default(false)
  permissions Json // Array of permission IDs

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Invitation {
  id        String   @id @default(uuid())
  email     String
  firstName String?
  lastName  String?
  token     String   @unique
  roleId    String? // Reference to WorkspaceRole
  roleTitle String? // Store the custom title from the form
  status    String   @default("PENDING") // PENDING, ACCEPTED, EXPIRED
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
}

// --- Dynamic Fields ---

model CustomField {
  id         String    @id @default(uuid())
  name       String
  entity     String    @default("TestCase")
  type       FieldType
  options    Json? // Used for Select/Multi-select options
  isRequired Boolean   @default(false)
  isSystem   Boolean   @default(false)
  order      Int       @default(0)
  isGlobal   Boolean   @default(true) // Applies to all projects if true

  projects Project[] @relation("ProjectToCustomField")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Environments & Milestones ---

model Environment {
  id          String  @id @default(uuid())
  title       String
  description String?
  slug        String

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testRuns TestRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
  @@index([projectId])
}

model Milestone {
  id          String    @id @default(uuid())
  title       String
  description String?   @db.Text
  status      String    @default("OPEN") // OPEN, COMPLETED
  dueDate     DateTime?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testRuns TestRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model SharedStep {
  id             String  @id @default(uuid())
  title          String
  action         String  @db.Text
  expectedResult String? @db.Text

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testSteps TestStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
}

model WorkspaceSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model PipelineSchedule {
  id          String  @id @default(uuid())
  title       String
  description String?
  cron        String // e.g. "0 0 * * *"
  isActive    Boolean @default(true)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  planId String?
  plan   TestPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([planId])
}

model AuditLog {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model DeploymentLog {
  id            String           @id @default(uuid())
  status        DeploymentStatus @default(PENDING)
  trigger       String // e.g., 'GitHub Webhook', 'Manual'
  logs          String?          @db.Text
  commitHash    String?
  commitMessage String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([createdAt])
}

model Notification {
  id          String           @id @default(uuid())
  recipientId String
  recipient   User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type        NotificationType
  entityId    String? // e.g., Case ID, Run ID
  link        String? // in-app href to navigate to on click
  title       String
  message     String?          @db.Text
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  @@index([recipientId, isRead, createdAt])
}

/// Every webhook delivery Qase makes, recorded before it is acted on.
///
/// A webhook you cannot inspect is a black box: this is what makes it possible
/// to answer "did Qase send it?" separately from "did we handle it?", and to
/// replay a delivery that failed while the app was down.
model QaseWebhookEvent {
  id String @id @default(uuid())

  /// Qase's `event_name`, e.g. "case.created", verbatim — including ones we
  /// do not handle, so unknown events surface instead of vanishing.
  eventName   String
  /// Qase's `project_code` from the envelope.
  projectCode String
  /// Id of the Qase entity the event is about, when the payload carries one.
  externalId  String?

  status  QaseWebhookStatus @default(RECEIVED)
  /// Why it was skipped, or the error if it failed.
  message String?           @db.Text
  /// The raw delivery, so a handler can be fixed and the event replayed.
  payload Json

  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([projectCode, receivedAt])
  @@index([status, receivedAt])
}

enum QaseWebhookStatus {
  /// Stored, not yet acted on.
  RECEIVED
  /// Applied to the database.
  PROCESSED
  /// Deliberately not applied — unknown event, unmapped project, or a record
  /// that already exists (sync is additive and never overwrites).
  SKIPPED
  /// Handler threw. `message` holds the error; the payload is kept for replay.
  FAILED
}
